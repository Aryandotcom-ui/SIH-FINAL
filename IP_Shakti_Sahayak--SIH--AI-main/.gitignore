
__pycache__/
*.pyc

# Runtime-generated data: SQLite registries/queues/audit trails, the
# Chroma vector index, and staged files from the auto-update pipeline.
# ai/corpus.yaml and the various ai/*/README.md files document how to
# (re)build these; none of them belong in version control.
/data/*.sqlite3
/data/chroma/
/data/updates_incoming/

# Dry-run / chunk-dump output from `python -m ai.cli --json-out`.
# Regenerable from the PDFs in data/pdfs; never the source of truth.
/build/

# Frontend build output and dependencies. Regenerated by
# scripts/run.sh (npm install / vite build); never the source of truth.
/frontend/node_modules/
/frontend/dist/
.env

# Local Python virtualenv.
/.venv/
