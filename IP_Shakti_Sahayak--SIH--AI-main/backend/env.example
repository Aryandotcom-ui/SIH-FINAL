# Backend
APP_NAME=IP-SAKTI Sahayak API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI / storage
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=ip_sakti_corpus
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
TOP_K=5
ABSTAIN_THRESHOLD=0.20
CORPUS_MANIFEST_PATH=ai/corpus.yaml
SQLITE_REGISTRY_PATH=data/registry.sqlite3

# Generation
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Kept for future Claude support.
ANTHROPIC_API_KEY=

# DPDP-aligned audit trail (ai/audit.py)
AUDIT_DB_PATH=data/audit.sqlite3
AUDIT_RETENTION_DAYS=180

# Auto-update pipeline (ai/updates) — off by default, see backend/README.md
UPDATES_SOURCES_PATH=ai/updates/sources.yaml
UPDATES_WATCHER_DB_PATH=data/updates_watcher.sqlite3
UPDATES_QUEUE_DB_PATH=data/updates_queue.sqlite3
UPDATES_STAGE_DIR=data/updates_incoming
UPDATES_SCHEDULER_ENABLED=false
UPDATES_INTERVAL_MINUTES=60
UPDATES_AUTO_INGEST=false

# Patent preparation and tracking (ai/patent_prep)
PATENT_CASES_DB_PATH=data/patent_cases.sqlite3

# Multilingual request/response edge (ai/translation.py) — without both
# set, queries and answers pass through untranslated (NullTranslator)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
